FROM php:8.3-apache
RUN docker-php-ext-install pdo_mysql
ARG API_GROUP
COPY Backend/config /var/www/html/Backend/config
COPY Backend/core /var/www/html/Backend/core
COPY Backend/models /var/www/html/Backend/models
COPY Backend/controllers /var/www/html/Backend/controllers
COPY Backend/database /var/www/html/Backend/database
COPY Backend/api/${API_GROUP} /var/www/html/Backend/api/${API_GROUP}
COPY Backend/api/notificaciones /var/www/html/Backend/api/notificaciones
COPY deploy/api.conf /etc/apache2/conf-enabled/sigeru.conf
RUN mkdir -p /var/lib/php/sessions && chown www-data:www-data /var/lib/php/sessions \
    && echo 'session.save_path=/var/lib/php/sessions' > /usr/local/etc/php/conf.d/sigeru.ini \
    && echo 'display_errors=Off' >> /usr/local/etc/php/conf.d/sigeru.ini
