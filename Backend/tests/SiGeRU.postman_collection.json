  "item": [
    {
      "name": "Iniciar sesión de administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{base_url}}/usuarios/login.php",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@sigeru.uy\", \"password\": \"admin123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('csrf', pm.response.json().csrf);"
            ]
          }
        }
      ]
    },
