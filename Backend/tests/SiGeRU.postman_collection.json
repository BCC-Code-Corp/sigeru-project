{
  "info": {
    "name": "SiGeRU - API REST (Testing de endpoints)",
    "description": "Colección de Postman para validar los 4 CRUD (Usuarios, Camiones, Contenedores, Centros de Acopio) y Auth (login/registro) del sistema SiGeRU, incluyendo los códigos de estado HTTP esperados en cada caso (200, 201, 400, 401, 404, 405, 409).\n\nCómo usarla:\n1. Importar este archivo en Postman (File > Import).\n2. Ajustar la variable de colección `base_url` si tu XAMPP/servidor no usa http://localhost/SiGeRU2/Backend.\n3. Correr la colección completa con el Collection Runner: cada request tiene un test que verifica el código HTTP de respuesta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost/SiGeRU2/Backend" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro - éxito (201 Created)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
            "pm.test('status success', function () { pm.expect(pm.response.json().status).to.eql('success'); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/usuarios/registro.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Vecino Postman\",\n  \"cedula\": \"49123324\",\n  \"email\": \"postman.test@sigeru.uy\",\n  \"password\": \"clave123\"\n}"
            }
          }
        },
        {
          "name": "Registro - datos incompletos (400 Bad Request)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/usuarios/registro.php",
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Sin datos\"\n}" }
          }
        },
        {
          "name": "Registro - cédula/email duplicados (409 Conflict)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('409 Conflict', function () { pm.response.to.have.status(409); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/usuarios/registro.php",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Vecino Prueba\",\n  \"cedula\": \"10000007\",\n  \"email\": \"vecino@sigeru.uy\",\n  \"password\": \"clave123\"\n}"
            }
          }
        },
        {
          "name": "Registro - método no soportado (405 Method Not Allowed)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('405 Method Not Allowed', function () { pm.response.to.have.status(405); });"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/api/usuarios/registro.php" }
        },
        {
          "name": "Login - éxito (200 OK)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', function () { pm.response.to.have.status(200); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/usuarios/login.php",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@sigeru.uy\",\n  \"password\": \"admin123\"\n}" }
          }
        },
        {
          "name": "Login - credenciales inválidas (401 Unauthorized)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/usuarios/login.php",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@sigeru.uy\",\n  \"password\": \"password-incorrecta\"\n}" }
          }
        },
        {
          "name": "Login - método no soportado (405 Method Not Allowed)",
